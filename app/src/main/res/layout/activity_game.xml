<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game_gradient">

    <!-- Top Status Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gameTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="24dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Pause / Back Button -->
        <ImageButton
            android:id="@+id/btnPause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_pause"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Level Info & Remaining Tiles (Centered horizontally on screen) -->
        <LinearLayout
            android:id="@+id/llLevelInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvGameLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="3"
                android:textColor="@color/text_light"
                android:textSize="20sp"
                tools:text="Level 4" />

            <TextView
                android:id="@+id/tvTilesRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#E8F5E9"
                android:textSize="12sp"
                tools:text="36 tiles left" />
        </LinearLayout>

        <!-- Coins Container -->
        <LinearLayout
            android:id="@+id/llGameCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stat_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_coin" />

            <TextView
                android:id="@+id/tvGameCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/text_light"
                android:textSize="14sp"
                tools:text="0" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Combo Pill Banner (Shown only when combo > 1) -->
    <LinearLayout
        android:id="@+id/llComboBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_stat_chip"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gameTopBar"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvCombo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textColor="#FF5722"
            android:textSize="15sp"
            tools:text="COMBO x2!" />
    </LinearLayout>

    <!-- Top Dock Tray (7-Slot Holding Area at Top) -->
    <com.aaritlabs.trinity.view.DockTrayView
        android:id="@+id/dockTrayView"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llComboBanner" />

    <!-- Board Area: Custom Layered Tile Board View -->
    <com.aaritlabs.trinity.view.TileBoardView
        android:id="@+id/tileBoardView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:layout_constraintBottom_toTopOf="@+id/llBoosters"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dockTrayView" />

    <!-- Booster Action Bar -->
    <LinearLayout
        android:id="@+id/llBoosters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Undo Booster -->
        <FrameLayout
            android:id="@+id/btnBoosterUndo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="16dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_booster_circle"
                android:contentDescription="@string/booster_undo"
                android:padding="12dp"
                android:src="@drawable/ic_undo" />

            <TextView
                android:id="@+id/tvBadgeUndo"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge_count"
                android:gravity="center"
                android:textColor="@color/text_light"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="3" />
        </FrameLayout>

        <!-- Shuffle Booster -->
        <FrameLayout
            android:id="@+id/btnBoosterShuffle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="16dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_booster_circle"
                android:contentDescription="@string/booster_shuffle"
                android:padding="12dp"
                android:src="@drawable/ic_shuffle" />

            <TextView
                android:id="@+id/tvBadgeShuffle"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge_count"
                android:gravity="center"
                android:textColor="@color/text_light"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="3" />
        </FrameLayout>

        <!-- Hint / Wand Booster -->
        <FrameLayout
            android:id="@+id/btnBoosterWand"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="16dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_booster_circle"
                android:contentDescription="@string/booster_wand"
                android:padding="12dp"
                android:src="@drawable/ic_wand" />

            <TextView
                android:id="@+id/tvBadgeWand"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge_count"
                android:gravity="center"
                android:textColor="@color/text_light"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="3" />
        </FrameLayout>

    </LinearLayout>

    <!-- Flying Tile & Sparkle Particle Animation Overlay -->
    <com.aaritlabs.trinity.view.FlyingTileOverlayView
        android:id="@+id/flyingTileOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
