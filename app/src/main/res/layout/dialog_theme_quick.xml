<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Themes &amp; Skins"
            android:textColor="@color/text_dark"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnCloseThemeModal"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="#E0E0E0" />

    <!-- Tile Items Skin Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="TILE ITEMS SKIN"
        android:textColor="@color/accent_gold"
        android:textSize="12sp" />

    <RadioGroup
        android:id="@+id/rgSkinQuick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <!-- Fruits & Food Skin -->
        <RadioButton
            android:id="@+id/rbSkinFruitsQuick"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="10dp"
            android:text="🍓 Fruits &amp; Food (Apple, Kiwi, Mango)"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <!-- Nature & Flowers Skin -->
        <RadioButton
            android:id="@+id/rbSkinFlowersQuick"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="10dp"
            android:text="🌺 Nature &amp; Flowers (Rose, Lotus, Clover)"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <!-- Smileys & Emotions Skin -->
        <RadioButton
            android:id="@+id/rbSkinEmotionsQuick"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="10dp"
            android:text="🤩 Smileys &amp; Emotions (Stars, Hearts)"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="#E0E0E0" />

    <!-- Color Theme Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="APP DISPLAY MODE"
        android:textColor="@color/accent_gold"
        android:textSize="12sp" />

    <RadioGroup
        android:id="@+id/rgThemeQuick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <!-- Light Theme -->
        <RadioButton
            android:id="@+id/rbThemeLightQuick"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="10dp"
            android:text="☀️ Light Jungle Mode"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <!-- Dark Theme -->
        <RadioButton
            android:id="@+id/rbThemeDarkQuick"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="10dp"
            android:text="🌙 Dark Ruins Mode"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <!-- System Theme -->
        <RadioButton
            android:id="@+id/rbThemeSystemQuick"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="10dp"
            android:text="📱 Follow System Settings"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />
    </RadioGroup>

</LinearLayout>
